meta {
  name: Send SMS
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/sms
  body: json
  auth: basic
}

auth:basic {
  username: demo-client-id
  password: demo-secret
}

headers {
  X-Workspace-Key: {{workspaceKey}}
}

body:json {
  {
    "to": ["+1234567890"],
    "message": "Your verification code is 123456"
  }
}

tests {
  test("should return 501 (SMS not implemented)", function() {
    expect(res.status).to.equal(501);
  });
}
