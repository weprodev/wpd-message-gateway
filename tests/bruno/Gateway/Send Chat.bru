meta {
  name: Send Chat
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/chat
  body: json
  auth: basic
}

auth:basic {
  username: demo-client-id
  password: demo-secret
}

headers {
  X-Workspace-Key: {{workspaceKey}}
}

body:json {
  {
    "to": ["+1234567890"],
    "message": "Hello from the gateway!",
    "platform": "whatsapp"
  }
}

tests {
  test("should return 501 (Chat not implemented)", function() {
    expect(res.status).to.equal(501);
  });
}
