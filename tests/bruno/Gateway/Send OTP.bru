meta {
  name: Send OTP
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/otp/revoke
  body: json
  auth: basic
}

headers {
  X-Workspace-Key: {{workspaceKey}}
}

auth:basic {
  username: {{apiClientId}}
  password: {{apiSecret}}
}

body:json {
  {
    "request_id": "178096435416219"
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("should return success boolean", function() {
    expect(res.body.success).to.be.a("boolean");
  });
}
