meta {
  name: Send Push
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/push
  body: json
  auth: basic
}

auth:basic {
  username: {{apiClientId}}
  password: {{apiSecret}}
}

headers {
  X-Workspace-Key: {{workspaceKey}}
}

body:json {
  {
    "device_tokens": ["your-device-token-or-phone-number"],
    "title": "Inactive User Reminder",
    "body": "⚠️ <b>You have been inactive for 3 days.</b>\nTap below to stay updated.",
    "data": {
      "parse_mode": "HTML"
    }
  }
}

tests {
  test("should return 200 and send message via Telegram", function() {
    expect(res.status).to.equal(200);
  });
}
