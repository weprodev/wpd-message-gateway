meta {
  name: Send Push
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/push
  body: json
  auth: basic
}

auth:basic {
  username: demo-client-id
  password: demo-secret
}

headers {
  X-Workspace-Key: {{workspaceKey}}
}

body:json {
  {
    "device_tokens": ["token-abc-123"],
    "title": "New Notification",
    "body": "You have a new message"
  }
}

tests {
  test("should return 501 (Push not implemented)", function() {
    expect(res.status).to.equal(501);
  });
}
