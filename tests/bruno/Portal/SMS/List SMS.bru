meta {
  name: List SMS
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/inbox/sms
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{portalJwt}}
  X-Api-Client-Id: {{apiClientId}}
  X-Api-Client-Secret: {{apiSecret}}
}


tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return paginated page", function() {
    expect(res.body).to.be.an("object");
    expect(res.body.items).to.be.an("array");
    expect(res.body).to.have.property("has_more");
  });

  test("should have SMS with required fields", function() {
    if (res.body.items.length > 0) {
      const sms = res.body.items[0];
      expect(sms).to.have.property("id");
      expect(sms).to.have.property("sms");
      expect(sms).to.have.property("created_at");
    }
  });
}
