meta {
  name: Get Provider Config
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/providers/mailgun/config
  body: none
  auth: bearer
}

auth:bearer {
  token: {{portalJwt}}
}

tests {
  test("should get provider config fields successfully", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    expect(res.body.length).to.be.at.least(1);
    const fieldKeys = res.body.map(f => f.key);
    expect(fieldKeys).to.include("api_key");
    expect(fieldKeys).to.include("domain");
    expect(fieldKeys).to.include("base_url");
    expect(fieldKeys).to.include("from_email");
    expect(fieldKeys).to.include("from_name");
  });
}
