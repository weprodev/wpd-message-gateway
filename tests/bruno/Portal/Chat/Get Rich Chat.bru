meta {
  name: Get Rich Chat
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/inbox/chat/{{richChatId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{portalJwt}}
  X-Api-Client-Id: {{apiClientId}}
  X-Api-Client-Secret: {{apiSecret}}
}


tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have rich chat fields populated", function() {
    const chat = res.body.chat;
    expect(chat.platform).to.equal("whatsapp");
    expect(chat.template_id).to.equal("order_shipped_v2");
    expect(chat.buttons).to.be.an("array");
    expect(chat.buttons.length).to.be.greaterThan(0);
  });
}
