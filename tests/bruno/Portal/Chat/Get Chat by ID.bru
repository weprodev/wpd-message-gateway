meta {
  name: Get Chat by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/inbox/chat/{{chatId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{portalJwt}}
  X-Api-Client-Id: {{apiClientId}}
  X-Api-Client-Secret: {{apiSecret}}
}


tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return chat object", function() {
    expect(res.body).to.have.property("id");
    expect(res.body).to.have.property("chat");
  });
}
