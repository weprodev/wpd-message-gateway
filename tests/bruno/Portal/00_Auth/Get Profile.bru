meta {
  name: Get Profile
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{portalJwt}}
}

tests {
  test("should get profile successfully", function() {
    expect(res.status).to.equal(200);
    expect(res.body.email).to.be.a("string");
    expect(res.body.workspaces).to.be.an("array");
  });
}
