meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "demo@weprodev.com",
    "password": "secret"
  }
}

tests {
  test("should login successfully", function() {
    expect(res.status).to.equal(200);
    expect(res.body.token).to.be.a("string");
  });

  bru.setVar("portalJwt", res.body.token);
}
