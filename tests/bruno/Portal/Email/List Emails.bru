meta {
  name: List Emails
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/inbox/emails
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{portalJwt}}
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return paginated page", function() {
    expect(res.body).to.be.an("object");
    expect(res.body.items).to.be.an("array");
    expect(res.body).to.have.property("has_more");
  });

  test("should have email with required fields", function() {
    if (res.body.items.length > 0) {
      const email = res.body.items[0];
      expect(email).to.have.property("id");
      expect(email).to.have.property("email");
      expect(email).to.have.property("created_at");
    }
  });
}
