meta {
  name: Get Rich Push
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/inbox/push/{{richPushId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{portalJwt}}
  X-Api-Client-Id: {{apiClientId}}
  X-Api-Client-Secret: {{apiSecret}}
}


tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have rich push fields populated", function() {
    const push = res.body.push;
    expect(push.title).to.include("Flash Sale");
    expect(push.data).to.be.an("object");
    expect(push.data.promotion_id).to.equal("FLASH-SALE-2026");
  });
}
