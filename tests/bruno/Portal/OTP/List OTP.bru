meta {
  name: List OTP
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/inbox/otp
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{portalJwt}}
  X-Api-Client-Id: {{apiClientId}}
  X-Api-Client-Secret: {{apiSecret}}
}


tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return array", function() {
    expect(res.body).to.be.an("array");
  });

  test("should have otp with required fields", function() {
    if (res.body.length > 0) {
      const otp = res.body[0];
      expect(otp).to.have.property("id");
      expect(otp).to.have.property("otp");
      expect(otp).to.have.property("created_at");
    }
  });
}
